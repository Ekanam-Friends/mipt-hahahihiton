# Local development model; set these variables in your shell before running the CLI.
# The application does not automatically load this file.
REGNAV_LLM=openai
OPENAI_BASE_URL=http://127.0.0.1:8087/v1
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=regnav-local
REGNAV_LLM_TIMEOUT=1800
REGNAV_MAX_TOKENS=1800

# Local-only is the default. 0 explicitly permits an external provider.
REGNAV_LOCAL_ONLY=1
# Comma-separated, explicitly trusted local model hosts (empty = loopback IPs only).
REGNAV_LOCAL_MODEL_HOSTS=
REGNAV_DATA=data/official
REGNAV_WEB_TIMEOUT=1800
# REGNAV_WEB_DB=data/official/web/accounts.sqlite3
# Docker Compose reads .env; CLI/uvicorn do not.
REGNAV_PORT=8000
